<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DonutHub</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            min-height: 100%;
        }

        body {
            min-height: 100vh;
            color: white;
            font-family: Arial, sans-serif;

            background:
                linear-gradient(
                    to bottom,
                    #071a35 0%,
                    #0b2548 30%,
                    #102f52 55%,
                    #071526 78%,
                    #020812 100%
                );

            background-attachment: fixed;
        }

        .hero {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
        }

        h1 {
            font-size: 80px;
            font-weight: 800;
            letter-spacing: 4px;
            text-shadow: 0 0 25px rgba(80, 160, 255, 0.4);
        }

        p {
            margin-top: 15px;
            font-size: 20px;
            color: #a9c8e8;
        }

        .buttons {
            margin-top: 35px;
            display: flex;
            gap: 15px;
        }

        button {
            padding: 14px 28px;
            border: none;
            border-radius: 10px;
            background: #1677d2;
            color: white;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            transition: 0.2s;
        }

        button:hover {
            background: #2990ed;
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(20, 120, 220, 0.35);
        }

        .section {
            min-height: 600px;
            padding: 100px 20px;
            text-align: center;
        }

        .section h2 {
            font-size: 40px;
            margin-bottom: 20px;
        }
    </style>
</head>

<body>

    <div class="hero">
        <h1>DONUTHUB</h1>
        <p>Your DonutSMP community hub</p>

        <div class="buttons">
            <button>SERVER</button>
            <button>SHOP</button>
            <button>DISCORD</button>
        </div>
    </div>

    <div class="section">
        <h2>DonutSMP</h2>
        <p>More features coming soon...</p>
    </div>

</body>
</html>
